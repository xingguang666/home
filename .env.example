# 站点信息
VITE_SITE_NAME = 墨竹小筑
VITE_SITE_AUTHOR = 你的名字
VITE_SITE_KEYWORDS = 个人主页,homepage
VITE_SITE_DES = 一个个人主页
VITE_SITE_URL = https://example.com
VITE_SITE_LOGO = /images/logo.png
VITE_SITE_MAIN_LOGO = /images/logo.png
VITE_SITE_MAIN_LOGO_SIZE = 38
VITE_SITE_APPLE_LOGO = /images/logo.png
# 应用版本号，用于缓存控制，每次更新应该递增这个值
VITE_APP_VERSION = 1.0.0

# 简介文本
VITE_DESC_HELLO = 你好
VITE_DESC_TEXT = 欢迎来到我的主页
VITE_DESC_HELLO_OTHER = Good Day
VITE_DESC_TEXT_OTHER = Welcome to my homepage

# 社交链接
## 请在 src/assets/socialLinks.json 文件中配置

# 网站链接
## 请在 src/assets/siteLinks.json 文件中配置
## 网站链接的图标名称可前往 https://www.xicons.org 自行挑选并在 src/components/Links/index.vue 中引入

# 天气 Key
## 请前往 高德开放平台注册 Web服务 Key
## 请注意不是 Web端 (JS API)，免费申请，每日上限 5000 次
VITE_WEATHER_KEY = 你的高德Web服务Key

# 默认城市（当IP定位失败时使用）
VITE_DEFAULT_CITY = 北京

# 建站日期
## 若不需要，请设为空即可
## 请按照 YYYY-MM-DD 格式填写或者仅填写年份 YYYY
VITE_SITE_START = 2024

# ICP 备案号
## 若不需要，请设为空即可
VITE_SITE_ICP =

# AI 聊天通过公开代理 API，无需本地 Key
# 旧模型（glm-4-flash）: oiapi.net
# 新模型（glm-4-6, claude）: apiserver.alcex.cn

# Meting API 地址（参考：https://github.com/xizeyoupan/Meting-API 部署）
# 公共API示例（可能不稳定）: https://api.injahow.cn/meting/
VITE_SONG_API = https://api.injahow.cn/meting/
# 平台: netease(网易云) | tencent(QQ音乐)
VITE_SONG_SERVER = netease
# 类型: playlist(歌单) | song(单曲) | album(专辑) | search(搜索)
VITE_SONG_TYPE = playlist
# 资源ID: 网易云歌单ID
VITE_SONG_ID = 123456789
